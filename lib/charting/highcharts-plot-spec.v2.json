{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "highcharts-plot-spec.v2",
  "title": "Highcharts Plot Spec V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module", "options"],
  "properties": {
    "schema_version": {
      "const": "highcharts-plot-spec.v2"
    },
    "module": {
      "type": "string",
      "enum": ["core", "stock", "maps", "gantt"]
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "highcharts-more",
          "drilldown",
          "heatmap",
          "tilemap",
          "treemap",
          "sunburst",
          "sankey",
          "organization",
          "dependency-wheel",
          "networkgraph",
          "wordcloud",
          "venn",
          "timeline",
          "xrange",
          "streamgraph",
          "item-series",
          "pareto",
          "dumbbell",
          "lollipop",
          "funnel",
          "histogram-bellcurve",
          "geoheatmap",
          "flowmap",
          "tiledwebmap"
        ]
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drilldown_async": {
          "type": "object",
          "additionalProperties": false,
          "required": ["loader_id", "series_by_id"],
          "properties": {
            "loader_id": {
              "type": "string"
            },
            "series_by_id": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "max_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          }
        }
      }
    }
  }
}
