{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Analyst",
  "version": "1.0.1",
  "identifier": "com.aianalyst.desktop",
  "build": {
    "frontendDist": "desktop-placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "shell": {
      "open": "^https://.+"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/runtime"],
    "externalBin": ["binaries/ai-analyst-server"],
    "category": "Productivity",
    "shortDescription": "AI Analyst",
    "longDescription": "AI Analyst desktop app",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
