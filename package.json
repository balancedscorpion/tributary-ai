{
  "name": "custom-stream-chat",
  "version": "1.0.1",
  "private": true,
  "description": "Stream Chat with OpenAI and BigQuery Tools",
  "scripts": {
    "dev": "vite",
    "build": "npm run echarts:check && tsc && vite build",
    "preview": "vite preview",
    "desktop:prepare": "node scripts/prepare-tauri-sidecars.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "tools:metadata:check": "node scripts/check-generated-tool-metadata.mjs",
    "test:tool-contracts": "node --test tests/regressions/tool-activity-disclosure.test.mjs tests/regressions/tool-presentation-rendering-contract.test.mjs tests/regressions/remote-permission-subject-contract.test.mjs tests/regressions/tool-test-metadata-ui-addressability.test.mjs tests/regressions/files-origin-reveal.test.mjs tests/regressions/file-provenance-from-artifact.test.mjs tests/regressions/artifact-download-naming.test.mjs tests/regressions/file-audit-scope-counts.test.mjs tests/regressions/remote-file-download-requests.test.mjs tests/regressions/sources-service-contracts.test.mjs tests/regressions/local-files-api-contracts.test.mjs tests/regressions/local-search-jobs-api-contracts.test.mjs tests/regressions/desktop-native-runtime-contract.test.mjs tests/regressions/local-computer-command-broker-contract.test.mjs tests/regressions/image-generation-settings.test.mjs tests/regressions/generated-image-preview.test.mjs tests/regressions/generated-image-card.test.mjs tests/regressions/bigquery-scan-budget-ui.test.mjs",
    "test:tool-backend": "cd server && go test -count=1 ./internal/chat/tools ./internal/chat/optionc ./internal/chat/httpapi ./internal/chat/store ./internal/permissions ./internal/chat/providers ./internal/server ./internal/githubcli ./internal/atlassian ./internal/slack",
    "test:e2e": "playwright test",
    "test:permissions-ui": "playwright test tests/e2e/permissions-tab-manageability.spec.ts",
    "test:file-surfaces": "playwright test tests/e2e/connector-file-renderer.spec.ts tests/e2e/files-audit-surface.spec.ts tests/e2e/files-audit-app-wiring.spec.ts tests/e2e/sources-dialog.spec.ts tests/e2e/local-files-renderer.spec.ts",
    "test:tool-ui-contracts": "playwright test tests/e2e/tool-renderer-matrix.spec.ts tests/e2e/generated-tool-renderer-resolution.spec.ts tests/e2e/permissions-tab-manageability.spec.ts tests/e2e/audit-trail-inspectors.spec.ts",
    "test:tool-migration": "npm run tools:metadata:check && npm run test:tool-backend && npx tsc --noEmit && npm run test:tool-contracts && npm run test:tool-ui-contracts && npm run build",
    "highcharts:sync": "node scripts/highcharts-disabled.mjs sync",
    "highcharts:check": "node scripts/highcharts-disabled.mjs check",
    "echarts:sync": "node scripts/sync-echarts-capabilities.mjs",
    "echarts:check": "node scripts/check-echarts-capabilities.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "autoprefixer": "^10.4.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.2",
    "katex": "^0.16.22",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.6.1",
    "recharts": "^3.7.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "shiki": "^3.22.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.2.0"
  }
}
